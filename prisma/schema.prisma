generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IncomingEvent {
  id                String   @id @default(cuid())
  source            String // "instagram_dm" | "instagram_comment"
  externalId        String   @unique // message id / comment id від Meta
  senderId          String // IG user id відправника
  senderUsername    String?
  text              String
  status            String   @default("pending") // pending | sent | edited_sent
  proposedReply     String?
  finalReply        String?
  telegramMessageId String? // для edit кнопок в Telegram
  awaitingEditReply Boolean  @default(false) // true, поки чекаємо текст правки від адміна в Telegram

  // AI-класифікація (FAQ SMM)
  categoryId             String? // "1.1", "2.1", "3.6", "6.1" тощо
  tier                   String? // "A" | "B" | "C" | "escalate" | null (не класифіковано)
  confidence             Float?
  senderConversationKey  String? // `${source}:${senderId}`, для repeat-detection

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([awaitingEditReply])
  @@index([senderConversationKey])
}

model Template {
  id             String   @id @default(cuid())
  categoryId     String   @unique // "1.1", "2.1", "3.6", "6.1" тощо
  tier           String // "A" | "B" | "C"
  section        String // людська назва: "Співпраця", "Благодійність" ...
  question       String // приклад питання з FAQ, для few-shot класифікації
  textVariants   String[] // один елемент для більшості; кілька — для 5.x і "двостанних" (3.1, 4.2, 3.6)
  hasPlaceholder Boolean  @default(false) // true якщо текст містить [щось] або потребує ручної перевірки перед відправкою
}
